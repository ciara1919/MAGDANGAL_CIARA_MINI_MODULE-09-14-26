#HELPER FUNCTIONS
def get_float(prompt):
    while True:
        try:
            print(prompt, end=" ", flush=True)
            sys.stdout.flush()
            return float(input())
        except ValueError"
            print(">>Invalid input. Please type a number(r.g., 3 .5). ")
        except EOFError:
            print("\n >> No Input Received. Exiting Program. ")
            raise SystemExit
            
